1.  #Создание папок и переход в рабочую директорию
    mkdir 'Work'
    cd 'Work'
    mkdir 'Лабораторная работа №1!'
    mkdir 'Sargsyan Victoria S.'

2.  #Установка прав доступа
    mkdir 'Контрольная работа №1!'
    chmod 772 'Контрольная работа №1!' #права для владельца и группы владельца: чтение, запись, выполнение, для остальных права запись
    chmod 200 'Sargsyan Victoria S.' #для владельца права только на запись

3.  #Создание пустых файлов
    touch 'Text @1' 'Text $2' 'Text #3'

4.  #Запись текста в Text @1 без текст. редактора
    cat > 'Text @1'
    Птица говорун отличается умом и сообразительностью!
    Отличается умом, отличается сообразительностью...

5.  #Копирование содержимого из Text @1 в Text $2
    cat 'Text @1' > 'Text $2'

6.  #Перемещение и копирование файлов
    mv 'Text $2' 'Лабораторная работа №1!'
    cp 'Text @1' 'Sargsyan Victoria S.'

7.  #Сжатие файлов и создание архива
    gzip 'Text @1'
    gzip 'Text #3'
    tar -cf MyAchiv.tar 'Text @1.gz' 'Text #3.gz'

8.  #Распаковка Text #3 и копирование строки
    gzip -d 'Text #3.gz'
    chmod 700 'Sargsyan Victoria S.' //нужно чтобы был доступ к папке 
    cd 'Sargsyan Victoria S.'
    head -n 1 'Text @1' >> '../Text #3'
    cd ..
    cat >> 'Text #3'
    Будь осторожен! Преступник вооружен!

9.  #Запись в Result_one строк в обратном порядке
    cd 'Sargsyan Victoria S.'
    touch 'Result_one'
    tail -n 1 'Text @1' > 'Result_one'
    head -n 1 'Text @1' >> 'Result_one'

10. #Переименование файла
    mv 'Result_one' 'Result_two'

11. #Запись содержимого файлов на букву T в Result_3
    cd ..
    touch 'Лабораторная работа №1!/Result_3'
    cat 'Sargsyan Victoria S.'/T* > 'Лабораторная работа №1!/Result_3'
    chmod 200 'Sargsyan Victoria S.' #возвращаем ограничение прав на папку по требованию задания

12. #Добавление информации о ядре и текущей даты
    uname -a >> 'Лабораторная работа №1!/Result_3'
    date >> 'Лабораторная работа №1!/Result_3'
    
13. #Создание итоговой папки Lab_1 и перемещение всех материалов
    cd ..
    mkdir 'Lab_1'
    mv 'sandbox' 'Work' 'Work_files' 'Lab_1'